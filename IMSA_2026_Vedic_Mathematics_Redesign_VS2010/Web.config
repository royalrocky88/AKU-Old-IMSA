<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="SSDMConnectionString"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=SSDM;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <globalization
    requestEncoding="utf-8"
    responseEncoding="utf-8"
    fileEncoding="utf-8"
    culture="en-IN"
    uiCulture="en-IN" />
    <compilation debug="true" targetFramework="4.0" />
    <httpRuntime targetFramework="4.0" />
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID" />
  </system.web>
</configuration>
